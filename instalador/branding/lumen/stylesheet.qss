/* Visual do instalador do Lúmen OS */
QWidget {
    font-family: "DM Sans", "Inter", "Noto Sans", sans-serif;
    font-size: 10.5pt;
    color: #17211f;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #d3e3de;
    border-radius: 10px;
    padding: 7px 18px;
}
QPushButton:hover { background-color: #eaf4f0; }
QPushButton:pressed { background-color: #dbe8e4; }
QPushButton:disabled { color: #9aaba7; background-color: #f1f6f4; }

QPushButton#view-button-next {
    background-color: #2f8c80;
    border-color: #2f8c80;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#view-button-next:hover { background-color: #23766c; }
QPushButton#view-button-next:disabled { background-color: #a9cfc8; border-color: #a9cfc8; color: #ffffff; }

QLineEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #d3e3de;
    border-radius: 9px;
    padding: 6px 10px;
    selection-background-color: #2f8c80;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus { border: 1px solid #2f8c80; }

QListView, QTreeView, QTableView {
    background-color: #ffffff;
    border: 1px solid #d3e3de;
    border-radius: 10px;
    selection-background-color: #2f8c80;
    selection-color: #ffffff;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #2f8c80;
    border: 1px solid #2f8c80;
    border-radius: 4px;
}

QProgressBar {
    border: 0;
    border-radius: 6px;
    background-color: #dbe8e4;
    min-height: 12px;
    max-height: 12px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    border-radius: 6px;
    background-color: #2f8c80;
}
