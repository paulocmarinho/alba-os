#!/usr/bin/env bash
# Roda uma vez a cada boot da ISO, antes da tela de login:
# fuso horário, idioma e o usuário "lumen" da sessão ao vivo.
set -u

ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime

if ! locale -a 2>/dev/null | grep -qi '^pt_BR.utf8$'; then
  locale-gen >/dev/null 2>&1 || true
fi

# Steam e bibliotecas de 32 bits também na sessão ao vivo.
if grep -q '^#\[multilib\]' /etc/pacman.conf; then
  sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' /etc/pacman.conf
fi

if ! id lumen >/dev/null 2>&1; then
  useradd -m -G wheel,audio,video,input,gamemode -s /bin/bash -c "Lumen" lumen 2>/dev/null \
    || useradd -m -G wheel,audio,video,input -s /bin/bash -c "Lumen" lumen
  passwd -d lumen >/dev/null
fi

exit 0
