#!/usr/bin/env bash
# Abre o instalador do Lúmen OS (Calamares) como administrador, na sessão ao vivo.
if pgrep -x calamares >/dev/null; then
  exit 0
fi
args=()
if [[ ! -f /etc/calamares/branding/lumen/branding.desc && -d /usr/share/lumen/instalador ]]; then
  args=(-c /usr/share/lumen/instalador)
fi
exec sudo -E env QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}" calamares "${args[@]}" "$@"
