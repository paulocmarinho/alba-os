#!/usr/bin/env bash
# Tela de entrada do Alba OS (roda como o usuário "greeter" do greetd, antes de qualquer sessão).
# Um compositor de tela única (cage) mostra a escolha de conta e a senha.
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/alba-entrada-$(id -u)}"
mkdir -p "$XDG_CACHE_HOME"
exec >"$XDG_CACHE_HOME/entrada.log" 2>&1
teclado="$(cat /etc/alba/teclado 2>/dev/null || echo br)"
case "$teclado" in
  br) export XKB_DEFAULT_LAYOUT=br XKB_DEFAULT_MODEL=abnt2 ;;
  us-intl) export XKB_DEFAULT_LAYOUT=us XKB_DEFAULT_VARIANT=intl ;;
  *) export XKB_DEFAULT_LAYOUT="$teclado" ;;
esac
export XCURSOR_THEME=Adwaita XCURSOR_SIZE=24 WLR_NO_HARDWARE_CURSORS=1 GDK_BACKEND=wayland
if ! compgen -G "/dev/dri/renderD*" >/dev/null; then
  export WLR_RENDERER=pixman WEBKIT_DISABLE_DMABUF_RENDERER=1 LIBGL_ALWAYS_SOFTWARE=1
  export WLR_SCENE_DEBUG_DAMAGE=rerender GSK_RENDERER=ngl
fi
exec cage -s -- python3 /usr/share/alba/casca/entrada.py
