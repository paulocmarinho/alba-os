<?xml version="1.0" encoding="UTF-8"?>
<!-- Gerenciador de janelas do Alba OS (labwc). -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>6</gap>
    <reuseOutputMode>yes</reuseOutputMode>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <theme>
    <name>Alba</name>
    <cornerRadius>12</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>yes</dropShadows>
    <titlebar>
      <layout>:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font place="ActiveWindow"><name>DM Sans</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>DM Sans</name><size>10</size><weight>bold</weight></font>
    <font place="MenuHeader"><name>DM Sans</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>DM Sans</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>DM Sans</name><size>11</size></font>
  </theme>

  <windowSwitcher preview="yes" outlines="yes">
    <osd show="yes" />
    <fields>
      <field content="icon" width="8%" />
      <field content="title" width="92%" />
    </fields>
  </windowSwitcher>

  <desktops number="1" />

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <snapping>
    <range inner="12" outer="12" />
    <overlay><enabled>yes</enabled></overlay>
    <topMaximize>yes</topMaximize>
  </snapping>

  <keyboard>
    <default />
    <!-- Alt+Tab do Alba (ícones grandes, como no Mac); soltar o Alt escolhe -->
    <keybind key="A-Tab"><action name="Execute" command="alba-enviar '{&quot;tipo&quot;: &quot;alternar&quot;, &quot;direcao&quot;: 1}'" /></keybind>
    <keybind key="A-S-Tab"><action name="Execute" command="alba-enviar '{&quot;tipo&quot;: &quot;alternar&quot;, &quot;direcao&quot;: -1}'" /></keybind>
    <keybind key="W-Tab"><action name="Execute" command="alba-enviar '{&quot;tipo&quot;: &quot;alternar&quot;, &quot;direcao&quot;: 1}'" /></keybind>
    <keybind key="W-l"><action name="Execute" command="alba-enviar bloquear" /></keybind>
    <keybind key="C-A-l"><action name="Execute" command="alba-enviar bloquear" /></keybind>
    <keybind key="C-A-t"><action name="Execute" command="alba-app terminal" /></keybind>
    <keybind key="W-e"><action name="Execute" command="alba-app arquivos" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Down"><action name="Iconify" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="W-d"><action name="ToggleShowDesktop" /></keybind>
    <!-- Launchpad: tecla Super sozinha ou F4; busca: Super+Espaço ou Alt+Espaço (como no Mac) -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="alba-enviar launchpad" /></keybind>
    <keybind key="W-space"><action name="Execute" command="alba-enviar busca" /></keybind>
    <keybind key="A-space"><action name="Execute" command="alba-enviar busca" /></keybind>
    <keybind key="XF86LaunchA"><action name="Execute" command="alba-enviar launchpad" /></keybind>
    <!-- Captura de tela -->
    <keybind key="Print"><action name="Execute" command="alba-captura" /></keybind>
    <keybind key="S-Print"><action name="Execute" command="alba-captura area" /></keybind>
    <keybind key="W-S-s"><action name="Execute" command="alba-captura area" /></keybind>
    <keybind key="W-S-3"><action name="Execute" command="alba-captura" /></keybind>
    <keybind key="W-S-4"><action name="Execute" command="alba-captura area" /></keybind>
    <!-- Fechar janela como no Mac, além do Alt+F4 -->
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
  </keyboard>

  <mouse>
    <default />
    <!-- Clique com o botão direito na área de trabalho não abre menu de outro sistema. -->
    <context name="Root">
      <mousebind button="Left" action="Press" />
      <mousebind button="Right" action="Press" />
      <mousebind button="Middle" action="Press" />
    </context>
  </mouse>
</labwc_config>
