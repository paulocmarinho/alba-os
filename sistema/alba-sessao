#!/usr/bin/env bash
# Sessão gráfica do Alba OS.
# Roda no login do tty1: liga o servidor do sistema e abre o compositor de janelas (labwc)
# com a casca do Alba (fundo, barra, dock e painéis). Programas como o Firefox abrem em
# janelas normais. Se o compositor não conseguir abrir três vezes seguidas, o Alba volta
# para o modo de segurança (interface única em tela cheia, sem programas externos).
set -u

ALBA=/usr/share/alba
PORTA=7070
CACHE="$HOME/.cache/alba"
mkdir -p "$CACHE"
exec >"$CACHE/sessao.log" 2>&1

TOKEN="$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 40)"
MODO=()
[[ -d /run/archiso ]] && MODO=(--live)

python3 "$ALBA/servidor/alba_servidor.py" --porta "$PORTA" --token "$TOKEN" --web "$ALBA/web" "${MODO[@]}" \
  >"$CACHE/servidor.log" 2>&1 &
SERVIDOR=$!
trap 'kill "$SERVIDOR" 2>/dev/null' EXIT

for _ in $(seq 1 100); do
  (exec 3<>"/dev/tcp/127.0.0.1/$PORTA") 2>/dev/null && break
  sleep 0.1
done

# Teclado escolhido nos Ajustes (ou na instalação).
teclado="$(cat "$HOME/.config/alba/teclado" 2>/dev/null || cat /etc/alba/teclado 2>/dev/null || echo br)"
case "$teclado" in
  br) export XKB_DEFAULT_LAYOUT=br XKB_DEFAULT_MODEL=abnt2 ;;
  us) export XKB_DEFAULT_LAYOUT=us ;;
  us-intl) export XKB_DEFAULT_LAYOUT=us XKB_DEFAULT_VARIANT=intl ;;
  pt) export XKB_DEFAULT_LAYOUT=pt ;;
  es) export XKB_DEFAULT_LAYOUT=es ;;
  gb) export XKB_DEFAULT_LAYOUT=gb ;;
esac

export ALBA_URL="http://127.0.0.1:$PORTA" ALBA_TOKEN="$TOKEN"
export XDG_CURRENT_DESKTOP="Alba:wlroots" XDG_SESSION_DESKTOP=alba XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1 GDK_BACKEND="wayland,x11" QT_QPA_PLATFORM="wayland;xcb" SDL_VIDEODRIVER="wayland,x11"
export XCURSOR_THEME=Adwaita XCURSOR_SIZE=24
export WLR_NO_HARDWARE_CURSORS=1
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus"
fi
# Sem placa de vídeo de verdade (ex.: Hyper-V): desenho por software, que é o que funciona lá.
if ! compgen -G "/dev/dri/renderD*" >/dev/null; then
  export WLR_RENDERER=pixman WEBKIT_DISABLE_DMABUF_RENDERER=1 LIBGL_ALWAYS_SOFTWARE=1
  # A tela do Hyper-V só mostra os pedaços que o compositor avisa que mudaram, e esses avisos
  # se perdem (a tela ficava "se revelando" onde o mouse passava). Redesenha a tela inteira.
  export WLR_SCENE_DEBUG_DAMAGE=rerender
  # O GTK precisa desenhar por OpenGL (mesmo de software): no modo sem OpenGL as páginas
  # chegam pela metade na tela (piscando). Não deixa o GTK escolher sozinho.
  export GSK_RENDERER=ngl
fi

# ---------------------------------------------------------------- modo de segurança (antigo)
quiosque() {
  local motor url perfil
  motor="$(command -v chromium || command -v chromium-browser)" || return 1
  url="http://127.0.0.1:$PORTA/?t=$TOKEN"
  perfil="$CACHE/motor"
  rm -rf "$perfil"
  cage -s -d -- "$motor" --kiosk "$url" --ozone-platform=wayland --user-data-dir="$perfil" \
    --force-device-scale-factor=1 --no-first-run --no-default-browser-check --noerrdialogs \
    --disable-infobars --disable-session-crashed-bubble --disable-translate --password-store=basic \
    --disable-sync --disable-extensions --disable-features=Translate,PasswordManagerOnboarding \
    --overscroll-history-navigation=0 --disable-pinch --lang=pt-BR &
}

falhas=0
modo=casca
while true; do
  rm -f "$CACHE/recarregar"
  # Nada da sessão anterior pode sobrar (casca ou apps com a senha antiga).
  pkill -u "$(id -u)" -f "/usr/bin/alba-casca" 2>/dev/null
  pkill -u "$(id -u)" -f "/usr/share/alba/casca/" 2>/dev/null
  inicio=$(date +%s)
  if [[ "$modo" == casca ]]; then
    rm -f "$CACHE/casca-falhou"
    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
      labwc -s "bash /usr/bin/alba-casca" >"$CACHE/compositor.log" 2>&1 &
    else
      # Sem barramento de sessão (os apps do Alba precisam de um): cria um só para a sessão.
      dbus-run-session -- labwc -s "bash /usr/bin/alba-casca" >"$CACHE/compositor.log" 2>&1 &
    fi
  else
    quiosque
  fi
  PID=$!
  while kill -0 "$PID" 2>/dev/null; do
    if [[ -f "$CACHE/recarregar" ]]; then
      kill "$PID" 2>/dev/null
      break
    fi
    sleep 0.5
  done
  wait "$PID" 2>/dev/null
  # Depois de uma atualização, a sessão inteira recomeça (servidor e script novos).
  if [[ "$(cat "$CACHE/recarregar" 2>/dev/null)" == "sessao" ]]; then
    rm -f "$CACHE/recarregar"
    kill "$SERVIDOR" 2>/dev/null
    wait "$SERVIDOR" 2>/dev/null
    exec /usr/bin/alba-sessao
  fi
  if [[ "$modo" == casca && -f "$CACHE/casca-falhou" ]]; then
    echo "A casca do Alba não abriu: entrando no modo de segurança."
    cp "$CACHE/compositor.log" "$CACHE/compositor-falhou.log" 2>/dev/null
    modo=quiosque
    falhas=0
    continue
  fi
  if (( $(date +%s) - inicio < 10 )); then
    falhas=$((falhas + 1))
    echo "Sessão fechou rápido demais ($falhas, modo $modo)."
    if [[ "$modo" == casca && $falhas -ge 3 ]]; then
      echo "Compositor não abriu: entrando no modo de segurança."
      modo=quiosque
      falhas=0
    fi
    sleep $(( falhas > 5 ? 5 : 1 ))
  else
    falhas=0
  fi
done
