# Tema de janelas do Alba OS para o labwc.
# Botões: três pontos à esquerda (fechar, minimizar, maximizar) que ganham cor no hover.
# A barra de título muda de tom com a hora do dia (sistema/casca/tema_janelas.py).
border.width: 1
padding.height: 7
padding.width: 8

window.active.border.color: #d8dfeb
window.inactive.border.color: #e1e5ee
window.active.title.bg.color: #eef2f8
window.inactive.title.bg.color: #eceff5
window.active.label.text.color: #15223e
window.inactive.label.text.color: #8b93a7
window.label.text.justify: center

window.titlebar.padding.width: 10
window.titlebar.padding.height: 0
window.button.width: 20
window.button.height: 26
window.button.spacing: 2
window.button.hover.bg.color: #00000000
window.button.hover.bg.corner-radius: 10

window.active.button.unpressed.image.color: #3a4660
window.inactive.button.unpressed.image.color: #a3abbd

window.active.shadow.size: 36
window.inactive.shadow.size: 22
window.active.shadow.color: #1c1a5a3a
window.inactive.shadow.color: #1c1a5a22

menu.border.width: 1
menu.border.color: #d6dbea
menu.items.bg.color: #f4f6fb
menu.items.text.color: #15223e
menu.items.active.bg.color: #5b6ee1
menu.items.active.text.color: #ffffff
menu.items.padding.x: 10
menu.items.padding.y: 6
menu.separator.color: #dde1ec
menu.overlap.x: 0

osd.bg.color: #f4f6fbf0
osd.border.color: #d6dbea
osd.border.width: 1
osd.label.text.color: #15223e
osd.window-switcher.width: 520
osd.window-switcher.padding: 8
osd.window-switcher.item.padding.x: 10
osd.window-switcher.item.padding.y: 6
osd.window-switcher.item.active.border.width: 2
osd.window-switcher.preview.border.color: #5b6ee1
