#!/usr/bin/env bash
# Atualizador do Alba OS (roda como root, chamado pela interface via sudo).
# Baixa o pacote de atualização mais recente publicado no GitHub, confere a soma SHA-256
# e troca os arquivos do Alba (interface, servidor, sessão). Não mexe nos seus arquivos.
set -euo pipefail

REPO="paulocmarinho/alba-os"
BASE="https://github.com/$REPO/releases/latest/download"
PACOTE="alba-atualizacao.tar.gz"

falhar() { echo "ERRO: $*" >&2; exit 1; }

# Tela de entrada (greetd): quem entra sozinho ao ligar o computador (vazio = ninguém).
configurar_entrada() {
  local auto="$1"
  install -d /etc/greetd
  {
    echo "# Gerado pelo Alba OS (Ajustes › Contas)."
    echo "[terminal]"
    echo "vt = 1"
    echo "[default_session]"
    echo 'command = "/usr/bin/alba-entrada"'
    echo 'user = "greeter"'
    if [[ -n "$auto" ]]; then
      echo "[initial_session]"
      echo 'command = "/usr/bin/alba-sessao"'
      echo "user = \"$auto\""
    fi
  } >/etc/greetd/config.toml.novo
  mv /etc/greetd/config.toml.novo /etc/greetd/config.toml
  echo "$auto" >/etc/alba/entrada-automatica
}
[[ $EUID -eq 0 ]] || falhar "precisa rodar como administrador."
[[ ! -d /run/archiso ]] || falhar "a sessão de instalação não se atualiza; instale o Alba primeiro."

# Ajustes do sistema que vêm dentro do Alba (/usr/share/alba/sistema) e precisam ir para /etc.
# Rodam no fim de cada atualização e também sozinhos ("alba-atualizar --ajustes"), que o Alba
# chama ao iniciar: assim um atualizador antigo, que não conhecia um ajuste, não trava nada.
aplicar_ajustes() {
  local S=/usr/share/alba/sistema
  if [[ -f "$S/50-alba.rules" && -d /etc/polkit-1 ]]; then
    install -d -m 750 /etc/polkit-1/rules.d
    chown root:polkitd /etc/polkit-1/rules.d 2>/dev/null || true
    cmp -s "$S/50-alba.rules" /etc/polkit-1/rules.d/50-alba.rules || install -m 644 "$S/50-alba.rules" /etc/polkit-1/rules.d/50-alba.rules
  fi
  # Tela de abertura (refaz a inicialização só na primeira vez; volta atrás se falhar)
  [[ -x /usr/local/bin/alba-abertura ]] && /usr/local/bin/alba-abertura || true
  # Tela de entrada com as contas (greetd) no lugar do login automático pelo tty1. Vale a
  # partir do próximo boot; quem entrava sozinho continua entrando sozinho. O tty2 continua
  # com o login de texto, como saída de emergência (Ctrl+Alt+F2).
  if [[ ! -e /etc/alba/entrada-greetd && -x /usr/bin/greetd && -x /usr/bin/alba-entrada && -x /usr/bin/cage ]] \
     && getent passwd greeter >/dev/null; then
    local auto=""
    auto="$(sed -n 's/.*--autologin \([^ ]*\).*/\1/p' /etc/systemd/system/getty@tty1.service.d/autologin.conf 2>/dev/null | head -1)"
    install -d /etc/alba
    configurar_entrada "$auto"
    usermod -a -G video,input greeter 2>/dev/null || true
    rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
    systemctl disable getty@tty1.service >/dev/null 2>&1 || true
    systemctl enable greetd.service >/dev/null 2>&1 || true
    touch /etc/alba/entrada-greetd
  fi
}

# Programas que o Alba precisa para funcionar: não podem ser removidos pela interface.
PROTEGIDOS_BASE="base linux linux-firmware linux-lts systemd pacman sudo bash glibc grub efibootmgr mkinitcpio networkmanager
polkit dbus pipewire wireplumber python python-gobject flatpak plymouth"
protegido() {
  local p="$1"
  [[ " $(echo $PROTEGIDOS_BASE) " == *" $p "* ]] && return 0
  grep -qxF "$p" /usr/share/alba/pacotes.txt 2>/dev/null && return 0
  return 1
}

# "alba-atualizar --sistema": atualiza o Linux por baixo (pacman -Syu). Uma linha por passo.
if [[ "${1:-}" == "--sistema" ]]; then
  [[ -e /var/lib/pacman/db.lck ]] && pgrep -x pacman >/dev/null && falhar "outro programa está instalando algo agora; tente daqui a pouco."
  rm -f /var/lib/pacman/db.lck
  echo "ETAPA Conferindo as chaves de segurança…"
  pacman -Sy --needed --noconfirm --noprogressbar archlinux-keyring || falhar "não consegui falar com os servidores do Arch Linux (sem internet?)."
  echo "ETAPA Atualizando o sistema…"
  pacman -Su --noconfirm --noprogressbar || falhar "a atualização do sistema não terminou. Nada foi perdido; tente de novo mais tarde."
  paccache -rk2 >/dev/null 2>&1 || true   # guarda só as 2 últimas versões baixadas (economiza disco)
  aplicar_ajustes
  [[ -d "/usr/lib/modules/$(uname -r)" ]] || echo "REINICIAR"
  echo "Pronto: sistema atualizado."
  exit 0
fi

# "alba-atualizar --remover PACOTE": desinstala um programa do sistema (a interface já pediu a senha).
if [[ "${1:-}" == "--remover" ]]; then
  pacote="${2:-}"
  [[ "$pacote" =~ ^[a-z0-9@._+-]+$ ]] || falhar "programa inválido."
  pacman -Qq "$pacote" >/dev/null 2>&1 || falhar "esse programa não está instalado."
  protegido "$pacote" && falhar "esse programa faz parte do Alba e não pode ser removido."
  dependentes="$(pacman -Qi "$pacote" | sed -n 's/^Required By *: *//p')"
  if [[ -n "$dependentes" && "$dependentes" != "None" ]]; then
    falhar "outros programas precisam dele: $dependentes."
  fi
  pacman -Rns --noconfirm --noprogressbar "$pacote" || falhar "não consegui remover."
  echo "Pronto: removido."
  exit 0
fi

# "alba-atualizar --conta AÇÃO ...": contas de usuário (criar, senha, nome, admin, remover,
# entrar automaticamente). A primeira linha da entrada é a senha de quem pediu (conferida aqui,
# como root): assim nenhum programa consegue mexer nas contas só por ter o sudo sem senha.
# A segunda linha, quando há, é a senha nova.
if [[ "${1:-}" == "--conta" ]]; then
  acao="${2:-}"; alvo="${3:-}"
  quem="${SUDO_USER:-}"
  [[ -n "$quem" ]] || falhar "não sei quem pediu."
  IFS= read -r senha_quem || true
  IFS= read -r senha_nova || true
  python3 -c 'import sys; sys.path.insert(0, "/usr/share/alba/servidor"); import pam; sys.exit(0 if pam.autenticar(sys.argv[1], sys.stdin.readline().rstrip("\n")) else 1)' \
    "$quem" <<<"$senha_quem" || falhar "senha incorreta."
  login_valido() { [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; }
  e_pessoa() { local u; u="$(id -u "$1" 2>/dev/null)" || return 1; (( u >= 1000 && u < 60000 )); }
  admins() { getent group wheel | cut -d: -f4 | tr ',' '\n' | grep -v '^$' || true; }
  case "$acao" in
    criar)
      nome="${4:-}"; admin="${5:-0}"
      login_valido "$alvo" || falhar "nome de usuário inválido: use letras minúsculas, números, - ou _ (começando por letra)."
      id "$alvo" >/dev/null 2>&1 && falhar "já existe uma conta com esse nome de usuário."
      [[ ${#senha_nova} -ge 1 ]] || falhar "escolha uma senha."
      [[ "$nome" != *:* && "$nome" != *,* ]] || falhar "o nome não pode ter dois-pontos nem vírgula."
      grupos="audio,video,input"; [[ "$admin" == 1 ]] && grupos="wheel,$grupos"
      useradd -m -G "$grupos" -s /bin/bash -c "${nome:-$alvo}" "$alvo" || falhar "não consegui criar a conta."
      printf '%s:%s\n' "$alvo" "$senha_nova" | chpasswd || { userdel -r "$alvo" 2>/dev/null; falhar "não consegui definir a senha."; }
      # Mesmo teclado e visual de quem criou, para a conta nova já abrir bonita.
      install -d -o "$alvo" -g "$alvo" "/home/$alvo/.config/alba"
      for f in teclado; do [[ -f "/home/$quem/.config/alba/$f" ]] && install -o "$alvo" -g "$alvo" -m 644 "/home/$quem/.config/alba/$f" "/home/$alvo/.config/alba/$f"; done
      echo "Pronto: conta criada." ;;
    senha)
      e_pessoa "$alvo" || falhar "conta inválida."
      [[ ${#senha_nova} -ge 1 ]] || falhar "escolha uma senha."
      printf '%s:%s\n' "$alvo" "$senha_nova" | chpasswd || falhar "não consegui trocar a senha."
      echo "Pronto: senha trocada." ;;
    nome)
      e_pessoa "$alvo" || falhar "conta inválida."
      nome="${4:-}"
      [[ -n "$nome" && "$nome" != *:* && "$nome" != *,* ]] || falhar "nome inválido."
      usermod -c "$nome" "$alvo" || falhar "não consegui trocar o nome."
      echo "Pronto: nome trocado." ;;
    admin)
      e_pessoa "$alvo" || falhar "conta inválida."
      if [[ "${4:-}" == 1 ]]; then
        gpasswd -a "$alvo" wheel >/dev/null
      else
        [[ "$(admins | grep -vx "$alvo" | wc -l)" -ge 1 ]] || falhar "o computador precisa ter pelo menos um administrador."
        gpasswd -d "$alvo" wheel >/dev/null
      fi
      echo "Pronto." ;;
    remover)
      e_pessoa "$alvo" || falhar "conta inválida."
      [[ "$alvo" != "$quem" ]] || falhar "você não pode remover a própria conta enquanto está usando."
      loginctl show-user "$alvo" >/dev/null 2>&1 && pgrep -u "$alvo" >/dev/null && falhar "essa conta está aberta agora; saia dela antes."
      if [[ "${4:-0}" == 1 ]]; then userdel -r "$alvo" 2>/dev/null || userdel "$alvo"; else userdel "$alvo"; fi
      [[ -f /etc/greetd/config.toml ]] && grep -q "user = \"$alvo\"" /etc/greetd/config.toml && /usr/local/bin/alba-atualizar --entrada-auto ""
      echo "Pronto: conta removida." ;;
    automatico)
      # alvo vazio = sempre pedir a senha ao ligar
      [[ -z "$alvo" ]] || e_pessoa "$alvo" || falhar "conta inválida."
      exec /usr/local/bin/alba-atualizar --entrada-auto "$alvo" ;;
    *) falhar "ação desconhecida." ;;
  esac
  exit 0
fi

if [[ "${1:-}" == "--entrada-auto" ]]; then
  [[ $# -ge 2 ]] || falhar "uso: --entrada-auto USUARIO"
  configurar_entrada "$2"
  echo "Pronto."
  exit 0
fi

if [[ "${1:-}" == "--ajustes" ]]; then
  aplicar_ajustes
  exit 0
fi

TMP="$(mktemp -d /var/tmp/alba-atualizacao.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT

echo "Baixando a atualização…"
curl -fsSL --retry 3 --connect-timeout 15 -o "$TMP/$PACOTE" "$BASE/$PACOTE" || falhar "não consegui baixar a atualização (sem internet?)."
curl -fsSL --retry 3 --connect-timeout 15 -o "$TMP/$PACOTE.sha256" "$BASE/$PACOTE.sha256" || falhar "não consegui baixar a soma de verificação."

echo "Conferindo…"
esperado="$(cut -d' ' -f1 "$TMP/$PACOTE.sha256")"
[[ "$esperado" =~ ^[0-9a-f]{64}$ ]] || falhar "soma de verificação inválida."
echo "$esperado  $TMP/$PACOTE" | sha256sum -c --quiet - || falhar "o pacote veio corrompido."

mkdir "$TMP/x"
tar -xzf "$TMP/$PACOTE" -C "$TMP/x" --no-same-owner --no-same-permissions --delay-directory-restore
# Só aceita os lugares que pertencem ao Alba.
while IFS= read -r -d '' item; do
  rel="${item#"$TMP/x/"}"
  case "$rel" in
    usr|usr/share|usr/share/alba|usr/share/alba/*|usr/bin|usr/bin/alba-*|usr/local|usr/local/bin|usr/local/bin/alba-*) ;;
    usr/share/themes|usr/share/themes/Alba|usr/share/themes/Alba/*) ;;
    etc/xdg|etc/xdg/labwc|etc/xdg/labwc/*|etc/xdg/mimeapps.list) ;;
    etc|etc/pacman.d|etc/pacman.d/hooks|etc/pacman.d/hooks/alba-*|etc/profile.d|etc/profile.d/alba.sh) ;;
    etc/chromium|etc/chromium/policies|etc/chromium/policies/managed|etc/chromium/policies/managed/alba.json) ;;
    etc/sudoers.d|etc/sudoers.d/20-alba-atualizar) ;;
    *) falhar "o pacote tem um arquivo fora do lugar: $rel" ;;
  esac
done < <(find "$TMP/x" -mindepth 1 -print0)
[[ -f "$TMP/x/usr/share/alba/web/index.html" ]] || falhar "pacote incompleto."
if [[ -f "$TMP/x/etc/sudoers.d/20-alba-atualizar" ]]; then
  visudo -cqf "$TMP/x/etc/sudoers.d/20-alba-atualizar" || falhar "regra de permissão inválida no pacote."
fi

# Programas novos que esta versão precisa (ex.: o compositor de janelas).
if [[ -f "$TMP/x/usr/share/alba/pacotes.txt" ]]; then
  mapfile -t faltando < <(grep -vE '^\s*(#|$)' "$TMP/x/usr/share/alba/pacotes.txt" | while read -r p; do pacman -Qq "$p" >/dev/null 2>&1 || echo "$p"; done)
  if (( ${#faltando[@]} )); then
    echo "Instalando programas novos: ${faltando[*]}"
    pacman -Syu --needed --noconfirm "${faltando[@]}" || falhar "não consegui instalar os programas novos (${faltando[*]})."
  fi
fi

echo "Instalando…"
A=/usr/share/alba
for parte in web servidor casca; do
  rm -rf "$A/$parte.velho"
  [[ -d "$A/$parte" ]] && mv "$A/$parte" "$A/$parte.velho"
done
# Arquivo por arquivo: as pastas do sistema (/usr, /etc…) mantêm dono e permissões.
(cd "$TMP/x" && find . -type f -print0) | while IFS= read -r -d '' f; do
  install -D -o root -g root -m 644 "$TMP/x/$f" "/${f#./}"
done
chmod 755 /usr/bin/alba-* /usr/local/bin/alba-* "$A/sistema/instalar.sh"
[[ -f /etc/sudoers.d/20-alba-atualizar ]] && chmod 440 /etc/sudoers.d/20-alba-atualizar
rm -rf "$A/web.velho" "$A/servidor.velho" "$A/casca.velho"
aplicar_ajustes

versao="$(python3 -c 'import json;d=json.load(open("/usr/share/alba/compilacao.json"));print(d.get("versao",""), d.get("commit","")[:7])' 2>/dev/null || true)"
echo "Pronto: Alba OS ${versao:-atualizado}."
